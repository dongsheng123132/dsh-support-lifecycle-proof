{
  "name": "dsh-support-lifecycle-proof",
  "version": "0.1.1",
  "description": "Offline content-addressed proof for supplied support lifecycle closure",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./proof": "./lib/support-lifecycle-proof.mjs"
  },
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "cordis.patch.yml",
    "index.js",
    "lib/",
    "mcp-server.mjs",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.2-alpha.4",
      "node": ">=22",
      "dshReleases": {
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke:mcp": "node test/mcp-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongsheng123132/dsh-support-lifecycle-proof.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "support-lifecycle",
    "eol",
    "evidence"
  ]
}
